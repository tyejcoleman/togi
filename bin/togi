#!/bin/sh
# Togi launcher: runs the system python3, ISOLATED (-I), against this checkout. Safe to symlink onto PATH.
#
# -I means no current directory and no PYTHONPATH on sys.path: nothing planted in the directory you are standing in
# (or in your environment) can run inside `togi approve` / `lock` / `revert` / `apply`. Togi's own src directory is
# added explicitly by _launch.py. Do not "simplify" this to `python3 -m togi`.
src=$0
while [ -h "$src" ]; do
  dir=$(cd -P "$(dirname "$src")" && pwd)
  src=$(readlink "$src")
  case $src in /*) ;; *) src=$dir/$src ;; esac
done
root=$(cd -P "$(dirname "$src")/.." && pwd)
exec python3 -I "$root/src/togi/_launch.py" "$@"
